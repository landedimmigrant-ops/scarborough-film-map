# macOS
.DS_Store

# Local editor / workspace config
.claude/

# Installed agent skills (payload) — re-installable from skills-lock.json
# via: npx skills add supabase/agent-skills
.agents/

# Large source dataset — derived into data/scarborough.geojson and re-downloadable
# from City of Toronto Open Data (URL in README). Not needed at runtime.
data/toronto-neighbourhoods.geojson

# Cloudflare Pages deploy artifact + local wrangler state (incl. the simulated R2 bucket)
dist/
.wrangler/

# Database credentials — NEVER commit these.
# .neon      : the Neon connection string, used by tools/*.mjs
# .dev.vars  : the same string, read by `wrangler pages dev` for local /api/* calls
# In production the string lives only in a Pages secret (see README).
.neon
.dev.vars
